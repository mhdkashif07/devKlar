# ── Devklar (a devAge project) — environment ───────────────────────────
# Copy this file to `.env.local` and fill in the values. `.env.local` is
# git-ignored. Keys are used server-side only and never sent to the browser.

# REQUIRED. Anthropic API key — https://console.anthropic.com/settings/keys
# Devklar uses Claude to read app ideas into tags. This needs billing/credits on
# your Anthropic account — there is NO free tier (unlike the old Gemini setup).
ANTHROPIC_API_KEY=

# OPTIONAL. Which Claude model to use for extraction. Defaults to claude-haiku-4-5
# (cheapest capable model — the right fit for this simple classification task).
# Set claude-sonnet-5 or claude-opus-5 if you want more nuance at higher cost.
ANTHROPIC_MODEL=claude-haiku-4-5

# RECOMMENDED for production. Canonical site URL — drives SEO (canonical tags,
# sitemap, Open Graph). No trailing slash. Defaults to https://devklar.devage.dev.
NEXT_PUBLIC_SITE_URL=https://devklar.devage.dev

# OPTIONAL. Where to forward agency leads from the contact form. If unset, leads
# are logged server-side (see src/app/api/lead/route.ts to wire email/webhook).
# LEAD_WEBHOOK_URL=
